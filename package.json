{
  "name": "context-cue",
  "private": true,
  "version": "0.1.0",
  "description": "How to Talk / Context Cue monorepo",
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "corepack pnpm --filter desktop dev",
    "build": "corepack pnpm --filter desktop build",
    "test": "corepack pnpm --filter desktop test",
    "lint": "corepack pnpm --filter desktop lint",
    "typecheck": "corepack pnpm --filter desktop typecheck",
    "audit:js": "corepack pnpm audit --audit-level high",
    "audit:rust": "cargo audit",
    "tauri:dev": "corepack pnpm tauri:dev:resume",
    "tauri:dev:new": "corepack pnpm --filter desktop tauri:dev:new",
    "tauri:dev:resume": "corepack pnpm --filter desktop tauri:dev:resume",
    "tauri:dev:user": "corepack pnpm --filter desktop tauri:dev:user",
    "tauri:dev:demo": "corepack pnpm --filter desktop tauri:dev:demo",
    "tauri:build": "corepack pnpm --filter desktop tauri build"
  }
}
