{
  "name": "desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "biome check src test ../../scripts vite.config.ts vitest.config.ts vitest.user.config.ts --files-ignore-unknown=true",
    "test": "vitest run && vitest run --config vitest.user.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "tauri:dev:new": "CONTEXT_CUE_LAUNCH_MODE=new VITE_CONTEXT_CUE_LAUNCH_MODE=new tauri dev",
    "tauri:dev:resume": "CONTEXT_CUE_LAUNCH_MODE=resume VITE_CONTEXT_CUE_LAUNCH_MODE=resume tauri dev",
    "tauri:dev:user": "CONTEXT_CUE_LAUNCH_MODE=resume VITE_CONTEXT_CUE_LAUNCH_MODE=resume tauri dev",
    "tauri:dev:demo": "CONTEXT_CUE_LAUNCH_MODE=demo VITE_CONTEXT_CUE_LAUNCH_MODE=demo tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
