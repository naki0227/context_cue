{
  "name": "desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "biome check src test ../../scripts vite.config.ts vitest.config.ts vitest.user.config.ts --files-ignore-unknown=true",
    "test": "vitest run && vitest run --config vitest.user.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "tauri:dev:new": "CONTEXT_CUE_LAUNCH_MODE=new VITE_CONTEXT_CUE_LAUNCH_MODE=new tauri dev",
    "tauri:dev:resume": "CONTEXT_CUE_LAUNCH_MODE=resume VITE_CONTEXT_CUE_LAUNCH_MODE=resume tauri dev",
    "tauri:dev:user": "CONTEXT_CUE_LAUNCH_MODE=resume VITE_CONTEXT_CUE_LAUNCH_MODE=resume tauri dev",
    "tauri:dev:demo": "CONTEXT_CUE_LAUNCH_MODE=demo VITE_CONTEXT_CUE_LAUNCH_MODE=demo tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
